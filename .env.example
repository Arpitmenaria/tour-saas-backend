PORT=8000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/busDB?retryWrites=true&w=majority

# Only needed for local testing of the keep-alive ping — Render sets RENDER_EXTERNAL_URL automatically
# SELF_URL=http://localhost:8000

# Optional cron schedule override (default: "*/10 * * * *" — every 10 minutes)
# For local testing, node-cron also accepts an optional leading seconds field, e.g. every 10s:
# KEEP_ALIVE_CRON=*/10 * * * * *
